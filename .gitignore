*.backup.log
webtalk*
usage_statistics_webtalk.*
*.pb
*.wdb
*.vcd
*.dmp
*.jou
*.log

# ==============================================================================
# 2. SIMULATION GENERATED OUTPUTS
# (Giữ lại verification/vectors/; bỏ qua dữ liệu xuất tự động khi chạy XSim)
# ==============================================================================
verification/results/*
!verification/results/.gitkeep

# ==============================================================================
